  "scripts": {
    "start": "npm run dev --workspace=frontend",
    "build": "npm run build-data && npm run build --workspace=frontend",
    "build-data": "tsx packages/scripts/compileData.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/lodash": "^4.17.23",
    "@types/node": "^25.2.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
