{
	"compilerOptions": {
		"module": "preserve",
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
	},
	"include": ["*.ts"],
	"exclude": ["node_modules"],
}